      "variants": [
        {
          "id": "14863e99a63554feaa8c32cde3c0eeea",
          "slot": 1,
          "text": "ここでのんびり、様子を見ていましょう。"
        },
        {
          "id": "f51d29aa17c659ed8661a4e7dd41589d",
          "slot": 2,
          "text": "{cat_call}のペースで過ごせるといいですね。"
        },
        {
          "id": "6f3f331507ec561bba9c5714b188b61e",
          "slot": 3,
          "text": "急がずに、静かな時間を大切にしましょう。"
        }
      ]
    },
    {
      "condition": {
        "kind": "speech",
