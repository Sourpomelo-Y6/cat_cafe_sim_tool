      },
      "variants": [
        {
          "id": "3f4e3074fa355c4d88ab06be9cfbffc8",
          "slot": 1,
          "text": "{cat_call}、今日は何してみようか？"
        },
        {
          "id": "56aeddf44d4d53089c7e329d69b3a7a8",
          "slot": 2,
          "text": "{cat_call}、ゆっくり観察してみようか。"
        },
        {
          "id": "1728c100d9ca5be28fc53d85718c810f",
          "slot": 3,
          "text": "{cat_call}、少し休憩してみようか？"
        }
      ]
    },
    {
      "condition": {
        "kind": "speech",
        "subject_id": "player",
        "mode": "presence",
        "action": "direct",
        "reaction": "any",
        "scene_key": "presence__direct",
        "target_cat": "*"
      },
      "variants": [
        {
          "id": "6bbecf6590975f99a49955d0962e3753",
          "slot": 1,
          "text": "{cat_call} ちょっと見守りましょうか？"
        },
        {
          "id": "cb9ed04a4a275dba8cace48de63ee948",
          "slot": 2,
          "text": "{cat_call} してみよう、そばで静かに見守るだけでいいかな"
        },
        {
          "id": "d81dc026ecec5eb098f8d9ef4465d2fa",
          "slot": 3,
          "text": "{cat_call} してもいいかな、静かにそばにいるだけでいいね"
        }
      ]
    },
    {
      "condition": {
        "kind": "speech",
        "subject_id": "player",
        "mode": "presence",
        "action": "adapt",
        "reaction": "any",
        "scene_key": "presence__adapt",
        "target_cat": "*"
      },
      "variants": [
        {
          "id": "d3e0b4372b445a34be3aaaa65955740f",
          "slot": 1,
          "text": "静かな雰囲気で{cat_call}に寄り添おうか。"
        },
        {
          "id": "c19de04b479453d19b6b8cdb78868795",
          "slot": 2,
          "text": "ゆっくりと一緒に{cat_call}を観察しようか。"
        },
        {
          "id": "274215cc5f4c56448fce0a63e03437f9",
          "slot": 3,
          "text": "そっと距離を保ちながら{cat_call}を見守ろうか。"
        }
      ]
    },
    {
      "condition": {
        "kind": "speech",
        "subject_id": "guest-1",
        "mode": "presence",
        "action": "any",
        "reaction": "any",
