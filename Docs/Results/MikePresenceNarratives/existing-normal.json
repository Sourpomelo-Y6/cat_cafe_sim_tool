      },
      "variants": [
        {
          "id": "53d6058e38055f7bb2d4890c9fccee5a",
          "slot": 1,
          "text": "{cat}は相手を見て少し背を向けた。"
        },
        {
          "id": "84b3467553825b4ba6e287b0cfc0dff8",
          "slot": 2,
          "text": "{cat}は相手を振り返り、少し足を引いた。"
        },
        {
          "id": "c19837c978b45d57a0211daea14898b7",
          "slot": 3,
          "text": "{cat}は相手の動きを見て、軽く体を横に回した。"
