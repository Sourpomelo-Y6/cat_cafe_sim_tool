      "variants": [
        {
          "id": "8e9f073cfcbd52c29a293a660038afc3",
          "slot": 1,
          "text": "そっと、ここで様子を見ていましょう。"
        },
        {
          "id": "cdde2ca8521455b3865c8a34846503ac",
          "slot": 2,
          "text": "{cat_call}のペースを大切にしたいですね。"
        },
        {
          "id": "c181e5d1104550539713b7223d8b9c55",
          "slot": 3,
          "text": "急がず、静かに見守っていましょう。"
        }
      ]
    },
    {
      "condition": {
