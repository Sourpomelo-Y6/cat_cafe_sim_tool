        },
        {
          "id": "cb9ed04a4a275dba8cace48de63ee948",
          "slot": 2,
          "text": "{cat_call} してみよう、そばで静かに見守るだけでいいかな"
        },
        {
          "id": "d81dc026ecec5eb098f8d9ef4465d2fa",
          "slot": 3,
          "text": "{cat_call} してもいいかな、静かにそばにいるだけでいいね"
