      "accepted": [
        {
          "speaker": "",
          "text": "そのまま待つと、タマはゆっくりと椅子の下から出てきた。"
        },
        {
          "speaker": "",
          "text": "すれ違いざま、足元でしっぽが小さく揺れた。"
        }
      ],
      "declined": [
        {
          "speaker": "",
          "text": "小さな声で名前を呼ぶと、タマの耳がぴくりと動いた。"
        },
        {
          "speaker": "",
          "text": "返事のように一歩近づいて、足元に腰を下ろした。"
        }
      ],
      "revision": "5e984530d390fcbe61a7ff4757ecc81339036479e8fc3523fc4c67801bd93e3e"
